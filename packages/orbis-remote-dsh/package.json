{
  "name": "@orbisapp/remote-dsh",
  "version": "0.2.4",
  "license": "Apache-2.0",
  "description": "Orbis remote plugin for DeepSeek Harness",
  "keywords": [
    "orbis",
    "dsh",
    "deepseek-harness",
    "remote"
