  "homepage": "https://github.com/icodesign/orbis#readme",
  "bugs": "https://github.com/icodesign/orbis/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/icodesign/orbis.git",
    "directory": "packages/orbis-remote-dsh"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "bundle": "tsx scripts/build.ts",
    "build": "pnpm run bundle",
    "build:core": "tsc -p tsconfig.core.json --noEmit",
    "prepack": "pnpm run bundle",
    "e2e:real": "tsx scripts/real-profile-e2e.ts",
    "serve:dsh": "node --import tsx scripts/serve-dsh-web.ts",
    "check": "pnpm run build && pnpm run typecheck && pnpm run test",
    "check:core": "pnpm run typecheck:core && pnpm run test:core",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "typecheck:core": "tsc -p tsconfig.core.json --noEmit && tsc -p tsconfig.core.test.json --noEmit",
    "test": "vitest run src scripts/real-profile-e2e-utils.test.ts",
    "test:core": "vitest run src/adapter src/host"
  },
